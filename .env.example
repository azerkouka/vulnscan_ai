# Copy this file to `.env` and fill in real values before running
# docker-compose or the backend locally. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=VulnScan AI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vulnscan
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Used directly by the backend (SQLAlchemy async driver). Keep the host in
# sync with the service name in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://vulnscan:change-me@postgres:5432/vulnscan

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-random-64-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call the API)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=vulnscan

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Uploads / scan limits (anti zip-bomb, anti zip-slip)
# ---------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=10
ZIP_MAX_UNCOMPRESSED_MB=100
ZIP_MAX_FILES=2000
ZIP_MAX_COMPRESSION_RATIO=100
ALLOWED_UPLOAD_EXTENSIONS=.py,.js,.ts,.jsx,.tsx,.java,.go,.php,.cs,.rb,.zip

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT=5/minute

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000/api/v1
