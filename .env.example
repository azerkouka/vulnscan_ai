# Copy this file to `.env` and fill in real values before running
# docker-compose or the backend locally. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=VulnScan AI
# development | test | staging | production. In production the backend
# refuses to start with DEBUG=true, a weak or placeholder JWT_SECRET_KEY or a
# wildcard CORS origin; it also turns the interactive API docs off and sends
# the HSTS header (so serve it over HTTPS).
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vulnscan
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port the database is published on, on your machine (not inside Docker).
# Change it if 5432 is already used by a locally installed PostgreSQL - the
# symptom is "connection was closed in the middle of operation" when running
# the tests or the backend outside Docker.
POSTGRES_HOST_PORT=5432
# Only read when the backend runs outside Docker (uvicorn, alembic or
# scripts on your machine) - point it at the published port then, e.g.
# ...@localhost:5432/vulnscan. Inside docker-compose the backend's URL is
# built from the POSTGRES_* values above, so this line is ignored there.
DATABASE_URL=postgresql+asyncpg://vulnscan:change-me@localhost:5432/vulnscan

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-random-64-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call the API)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=vulnscan

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# Context window requested from Ollama. Its own default (2048 tokens) is too
# small for a code chunk plus the knowledge-base excerpts and silently
# truncates the prompt.
OLLAMA_NUM_CTX=8192
# Extra attempts when the model's reply isn't the expected JSON.
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Scan analysis
# ---------------------------------------------------------------------------
# Upper bound, in lines, of one code chunk sent to the LLM.
CHUNK_MAX_LINES=120
# Scans analyzed at the same time. Keep at 1 unless the Ollama host can
# really serve several requests in parallel.
SCAN_MAX_CONCURRENT_JOBS=1

# ---------------------------------------------------------------------------
# Uploads / scan limits (anti zip-bomb, anti zip-slip)
# ---------------------------------------------------------------------------
# Where submitted source is kept until its scan is deleted (a Docker volume
# in docker-compose).
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10
ZIP_MAX_UNCOMPRESSED_MB=100
ZIP_MAX_FILES=2000
ZIP_MAX_COMPRESSION_RATIO=100
ALLOWED_UPLOAD_EXTENSIONS=.py,.js,.ts,.jsx,.tsx,.java,.go,.php,.cs,.rb,.zip

# ---------------------------------------------------------------------------
# Rate limiting / abuse protection
# ---------------------------------------------------------------------------
# Per client IP, on login and registration.
AUTH_RATE_LIMIT=5/minute
# Per client IP, on scan submission.
SCAN_RATE_LIMIT=20/minute
# Queued or running scans one user may have at a time. Scans are analyzed one
# after another by a single model, so this keeps one account from filling
# the queue.
MAX_ACTIVE_SCANS_PER_USER=3

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Not read by the Angular app yet: the API address it calls is set in
# frontend/src/environments/ (dev: http://localhost:8000/api/v1, production:
# same-origin /api/v1 behind nginx).
API_BASE_URL=http://localhost:8000/api/v1
